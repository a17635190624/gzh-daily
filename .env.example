# ============ AI 服务 ============
# DeepSeek（文本生成，OpenAI 兼容协议）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# 阿里云 DashScope（图片生成 / 通义万相）
# https://dashscope.aliyun.com → API-KEY 管理
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ============ 邮件推送 ============
# 163 邮箱示例
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=yourname@163.com
SMTP_PASS=xxxxxxxxxxxxxxxxxxxx       # 16 位授权密码（不是登录密码）

# 收件人（默认 = 发件人自己）
TO_ADDR=yourname@163.com